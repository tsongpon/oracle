# Backend API base URL used by src/lib/auth/auth.ts.
# - Empty/unset  -> same-origin requests (use the Vite dev proxy in dev;
#                   see vite.config.ts -> server.proxy['/v1']).
# - Set to e.g. 'https://echo-443460999135.asia-southeast1.run.app' to call
#                   the backend directly (requires CORS on the backend).
VITE_API_BASE_URL=

# Vite dev proxy target for /v1. Used only by `npm run dev`.
# Defaults to http://localhost:1323 (the spec's local dev base URL). Set to
# the Cloud Run service URL to develop against the deployed backend.
VITE_API_PROXY_TARGET=https://echo-443460999135.asia-southeast1.run.app
