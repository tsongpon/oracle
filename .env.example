# Backend API base URL used by src/lib/auth/auth.ts.
# - Empty/unset  -> same-origin requests (use the Vite dev proxy in dev;
#                   see vite.config.ts -> server.proxy['/v1']).
# - Set to e.g. 'http://localhost:1323' to call the backend directly
#                   (requires CORS on the backend; see Login API spec §11.3).
VITE_API_BASE_URL=

# Vite dev proxy target for /v1. Used only by `npm run dev`.
# Defaults to http://localhost:1323 (the spec's dev base URL).
VITE_API_PROXY_TARGET=http://localhost:1323